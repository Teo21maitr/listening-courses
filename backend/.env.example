# Upload limit for PDF files (in megabytes)
MAX_PDF_SIZE_MB=100

# Maximum characters per text chunk sent to Piper
TEXT_CHUNK_MAX_CHARS=1500

# Final MP3 encoding
OUTPUT_AUDIO_BITRATE=128k
OUTPUT_AUDIO_CHANNELS=1

# Working directory for uploads, chunks and generated audio (relative to backend/)
TEMP_DIR=./tmp

# TTS engine per language: "piper" (fast, robotic) or "kokoro" (slower, natural)
TTS_ENGINE_FR=kokoro
TTS_ENGINE_EN=kokoro

# Piper voice models directory (relative to backend/); one sub-folder per language
PIPER_MODELS_DIR=./models/piper
PIPER_VOICE_FR=fr_FR-siwis-medium
PIPER_VOICE_EN=en_US-lessac-medium

# Kokoro model files (see README) and voice per language
KOKORO_MODELS_DIR=./models/kokoro
KOKORO_MODEL_FILE=kokoro-v1.0.onnx
KOKORO_VOICES_FILE=voices-v1.0.bin
KOKORO_VOICE_FR=ff_siwis
KOKORO_VOICE_EN=af_heart

# Prosody: speaking rate (1.0 = normal, >1 faster) and silences inserted by the app
TTS_SPEED=1.0
TTS_SENTENCE_PAUSE_MS=250
TTS_PARAGRAPH_PAUSE_MS=600

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Built frontend to serve from FastAPI (leave empty in development)
FRONTEND_DIST_DIR=

# Jobs older than this are purged (audio files included)
JOB_TTL_HOURS=6

# Number of jobs processed in parallel (Piper is CPU-bound, keep it low)
MAX_CONCURRENT_JOBS=1
